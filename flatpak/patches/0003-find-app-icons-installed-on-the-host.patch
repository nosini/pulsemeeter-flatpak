+def add_host_icon_paths():
+    '''
+    Let the icon theme find app icons installed on the host (see HOST_ICON_PATHS).
+    '''
+    icon_theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
+    search_path = icon_theme.get_search_path()
+    for path in HOST_ICON_PATHS:
+        if os.path.isdir(path) and path not in search_path:
+            icon_theme.add_search_path(path)
