+# Host icon folders that GTK doesn't search inside a Flatpak sandbox. They are
+# only visible with --filesystem=host-os, which mounts the host's /usr at
+# /run/host/usr. Apps' icons installed by xdg-icon-resource end up in
+# /usr/local/share/icons.
+HOST_ICON_PATHS = (
+    '/run/host/usr/local/share/icons',
+    '/run/host/usr/local/share/pixmaps',
+    '/run/host/usr/share/pixmaps',
+)
